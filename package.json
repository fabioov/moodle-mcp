{
  "name": "moodle-mcp",
  "version": "0.1.0",
  "description": "Open source MCP server for Moodle (read-only): assignments, deadlines, grades, courses and more.",
  "license": "MIT",
  "author": "fabioov (https://github.com/fabioov)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fabioov/moodle-mcp.git"
  },
  "homepage": "https://github.com/fabioov/moodle-mcp#readme",
  "bugs": {
    "url": "https://github.com/fabioov/moodle-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "moodle",
    "claude",
    "lms",
    "cloudflare-workers",
    "education"
  ],
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "moodle-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "dev:worker": "wrangler dev",
    "deploy": "wrangler deploy",
    "check:worker": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.6",
    "@hono/node-server": "^2.1.6",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  }
}
